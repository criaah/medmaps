":[{"id":"32","parent":"31","text":"Trichinella spiralis","guid":"NTO2Tx2wTxWgU6El67NV8Q","children":[]},{"id":"33","parent":"31","text":"Echinococcus","guid":"Vj69xjRzRSe5rKpTe3NFtw","children":[]}]},{"id":"34","parent":"12","text":"AUTOINMUNE","guid":"JqzEhSxsT82iVyUtrXbp1A","children":[{"id":"35","parent":"34","text":"Lupus eritematoso sistemico","guid":"ZEc8FRDFQYqZlvyRKlSdFA","children":[]},{"id":"36","parent":"34","text":"Sarcoidosis cardiaca (granulomatosa, arritmias graves)","guid":"Zn1-F5iLS6mvZZuTYtnZbQ","children":[]},{"id":"37","parent":"34","text":"Miocarditis de celulas gigantes (fulminante, mortalidad alta)","guid":"JdiuKCD0SOKWKMfc3NBhkQ","children":[]},{"id":"38","parent":"34","text":"Enfermedad celiaca","guid":"VOmKuJ7OQPqtRKI9v0e1lw","children":[]},{"id":"39","parent":"34","text":"EICH (enfermedad injerto contra huesped)","guid":"hPSg8tXNQaix-r2vRfm9gg","children":[]},{"id":"40","parent":"34","text":"Esclerodermia","guid":"U-DyrS6jRY2JDU0kjajWCA","children":[]}]},{"id":"41","parent":"12","text":"FARMACOS","guid":"RTqe-loHRJGEA58VUXTYBA","children":[{"id":"42","parent":"41","text":"Clozapina (psicosis - incidencia ~0.7-1.2%, mortalidad alta si no detectada)","guid":"d8xUCAxmQS-Hqbw05anG8Q","children":[]},{"id":"43","parent":"41","text":"Antraciclinicos (doxorrubicina, epirrubicina - dosis-dependiente)","guid":"SnliVF3lRASWh7bbsWDZNA","children":[]},{"id":"44","parent":"41","text":"Ciclofosfamida (altas dosis trasplante)","guid":"fMjRvCbKSneAgUzYQBWyiw","children":[]},{"id":"45","parent":"41","text":"Cocaina (vasospasmo + miocarditis toxica)","guid":"QMCEKXDVQnmqzHqnSt8zqA","children":[]},{"id":"46","parent":"41","text":"Anfetaminas","guid":"85xYsiPMTva2HICl8sNqXA","children":[]},{"id":"47","parent":"41","text":"Litio","guid":"vW48IQV_T0ONjsio2JQyYw","children":[]}]},{"id":"48","parent":"12","text":"INHIBIDORES CHECKPOINT (ICI) - CRITICO EN ONCO-GERIATRIA","guid":"LM66MZhLT1C6ZLNZ_-I4Wg","children":[{"id":"49","parent":"48","text":"Ipilimumab (anti-