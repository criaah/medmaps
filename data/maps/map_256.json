SqCADmXO0kCorw","children":[]},{"id":"163","parent":"161","text":"Complementario a RM en granulomatosas","guid":"Z1CQEf3QT_6z5MtXTGbtng","children":[]}]}]},{"id":"164","parent":"0","text":"Diagnostico Diferencial","guid":"CBLX1D80ROC2zJ7vYuffqw","children":[{"id":"165","parent":"164","text":"SCA (PRINCIPAL Y MAS URGENTE)","guid":"AbeUyXwcTyCl9knYZ4e-iQ","children":[{"id":"166","parent":"165","text":"SEMEJANZAS: dolor toracico + troponina + elevacion ST","guid":"8tOp9HFGQgGmFBAF3BuWGQ","children":[]},{"id":"167","parent":"165","text":"DIFERENCIAS CLAVE","guid":"cPNC6he9Toyj2EagGHzBOQ","children":[{"id":"168","parent":"167","text":"SCA: elevacion ST localizada + coronaria culpable en coronariografia","guid":"O6P8GKr7QO-vwsr--cBY0Q","children":[]},{"id":"169","parent":"167","text":"Miocarditis: coronariografia normal + LGE no isquemica en RM","guid":"yDEsPvLySCWAiz6WoR0-qw","children":[]},{"id":"170","parent":"167","text":"Miocarditis: prodromo viral + edad joven","guid":"4sw0HAa0RjaN8v8ZULSOKg","children":[]}]},{"id":"171","parent":"165","text":"REGLA PRACTICA: toda elevacion ST + troponina sin causa clara -> coronariografia","guid":"jh7hmMXHSISDsmcreIncjQ","children":[]}]},{"id":"172","parent":"164","text":"SINDROME DE TAKO-TSUBO (CRITICO EN ADULTO MAYOR Y MUJER)","guid":"1X6t_vQ-RkGNlBPhMalMdQ","children":[{"id":"173","parent":"172","text":"Disfuncion VI apical + base hipercinetica","guid":"T_oUFvlRSSG3N2xDzri0Iw","children":[]},{"id":"174","parent":"172","text":"Desencadenante emocional/fisico","guid":"lVtn8l1tT_2hw_cwcdGqBw","children":[]},{"id":"175","parent":"172","text":"Coronariografia normal","guid":"K_PACXuxRPi0pSY4M-84ew","children":[]},{"id":"176","parent":"172","text":"RM: sin LGE (diferenciador clave)","guid":"BagxYECOQKyoRfuu2FVFyA","children":[]},{"id":"177","parent":"172","text":"Mas frecuente en mujeres posmenopausicas","guid":"vWZKaremRBydZWb2tb77ig","children":[]}]},{"id":"178","parent":"164","text":"CARDIOMIOPATIA DILATADA IDIOPATICA","guid":"mQH-NY4RQzGM8SxlS9AYeg","children":[{"id":"179","parent":"178","text":"Diagnostico de exclusion","guid":"a0doMd0mSAerqA0iinU7Dg","children":[]},{"id":"180","parent":"178","text":"Disfuncion VI cronica, sin marcadores inflamatorios agudos","guid":"TCV5cVD4SKyxeMDwqAE6Fg","children":[]},{"id":"181","parent":"178","text":"Puede ser secuela de miocarditis no diagnosticada","guid":"0bh9E0qKTdO4yPA77AXpbQ","children":[]}]},{"id":"182","parent":"164","text":"SARCOIDOSIS CARDIACA","guid":"v9EwUniRSoa7a55nk-vD2g","children":[{"id":"183","parent":"182","text":"BAV + arritmias ventriculares en adulto joven-medio","guid":"6QTvB1NrS3-2rUjr0EP4iQ","children":[]},{"id":"184","parent":"182","text":"FDG-PET: captacion focal","guid":"iWONvJQLSOecnO5ZEo-xhA","children":[]},{"id":"185","parent":"182","text":"Biopsia: granulomas sin necroisis caseosa","guid":"KnniuvjfSU28OLM0_z9dag","children":[]}]},{"id":"186","parent":"164","text":"MIOPERICARDITIS","guid":"jC69EU21TByEK9nytDAIzw","children":[{"id":"187","parent":"186","text":"Pericarditis con compromiso miocardico","guid":"ijRjHjp8SxG6W47cePVpHQ","children":[]},{"id":"188","parent":"186","text":"Troponina elevada + signos de pericarditis","guid":"si23maRBQrORGfH7XMcn-Q","children":[]},{"id":"189","parent":"186","text":"RM: LGE + edema + derrame pericardico","guid":"W2z4I3d8ROGtXqGVqxvI0A","children":[]}]},{"id":"190","parent":"164","text":"CHAGAS CARDIACO CRONICO","guid":"eXcM_rfgQAuFDRMdtsbsYA","children":[{"id":"191","parent":"190","text":"Aneurisma apical izquierdo","guid":"Jhz5yN6UTu6o96YKqrkJpQ","children":[]},{"id":"192","parent":"190","text":"BCRD + HBAI en ECG","guid":"xoigWXRcRW2fI3IuOAF8MA","children":[]},{"id":"193","parent":"190","text":"Serologia Trypanosoma cruzi positiva","guid":"N_T1hEhFQj6grdD0U1ZtlQ","children":[]}]},{"id":"194","parent":"164","text":"CARDIOTOXICIDAD POR ANTRACICLINICOS","guid":"_al4FFc5Rkm-eGuBU0Qu0A","children":[{"id":"195","parent":"194","text":"Exposicion previa documentada","guid":"QA027ZpiRRajxl94ksZSbg","children":[]},{"id":"196","parent":"194","text":"Disfuncion VI dosis-dependiente","guid":"v6Ua-9XmSOuI3K_8CZgC8Q","children":[]},{"id":"197","parent":"194","text":"Sin marcadores inflamatorios agudos","guid":"fxD0DBukSNSK8Q9XUphcMQ","children":[]}]}]},{"id":"198","parent":"0","text":"Manejo","guid":"MPi8QTkIRZuZZWSpRJFdCA","children":[{"id":"199","parent":"198","text":"SOPORTIVO (BASE DEL TRATAMIENTO EN TODAS LAS FORMAS)","guid":"DWoLAFcLTG6qNTfL8pzexg","children":[{"id":"200","parent":"199","text":"TERAPIA GDMT IC (si FEVI <40%)","guid":"l22otYd9QFCoYSE-ZfTO0g","children":[{"id":"201","parent":"200","text":"IECA/ARNI (enalapril/sacubitril-valsartan)","guid":"tiH93ip5QRSZ8lPS2IwN6w","children":[]},{"id":"202","parent":"200","text":"Betabloqueadores (bisoprolol, carvedilol, metoprolol)","guid":"eJR1YukOQKelQd-Kbdi9pg","children":[]},{"id":"203","parent":"200","text":"ARM (espironolactona, eplerenona)","guid":"R1mV_y6yTfSAIqEPATTMZw","children":[]},{"id":"204","parent":"200","text":"SGLT2i (dapagliflozina, empagliflozina - beneficio en IC)","guid":"yPORY_KQQcetRamHfQcsXw","children":[]}]},{"id":"205","parent":"199","text":"DIURETICOS (si congestion)","guid":"Kr8hIYDcTVuyynExmmQc_w","children":[{"id":"206","parent":"205","text":"Furosemida segun necesidad","guid":"P65qa8HBSGiYeYIqnl4bKg","children":[]}]},{"id":"207","parent":"199","text":"RESTRICCION DE EJERCICIO (OBLIGATORIA)","guid":"msj1o2gqTc-K6otsSiBaxw","children":[{"id":"208","parent":"207","text":"Minimo 3-6 meses en TODAS las formas","guid":"BZDwCX40SuywZ9OYRUtZNA","children":[]},{"id":"209","parent":"207","text":"Hasta normalizacion clinica + RM + troponinas","guid":"uQ9SODpDRZGOo1Rghp1DFw","children":[]},{"id":"210","parent":"207","text":"Atletas: minimo 3-6 meses sin competicion","guid":"V7nituoLSUqlAcf57r0-ug","children":[]},{"id":"211","parent":"207","text":"Reinicio precoz = causa mas frecuente de arritmia y deterioro","guid":"M7RdGn2SRHi_5tRvHx7sbg","children":[]}]}]},{"id":"212","parent":"198","text":"INMUNOSUPRESION (SELECTIVA - NO en miocarditis viral aguda)","guid":"t2HdPCx2Rne3nXS895Y1iw","children":[{"id":"213","parent":"212","text":"SARCOIDOSIS CARDIACA","guid":"IrcVQOg2Q8yp91GRsn4anA","children":[{"id":"214","parent":"213","text":"Prednisona 0.5-1 mg/kg/dia -> reduccion gradual 6-24 meses","guid":"VJaX85F0Rs-WJPSucqNIrQ","children":[]}]},{"id":"215","parent":"212","text":"MIOCARDITIS DE CELULAS GIGANTES","guid":"O9GE7k5KQxyKGTwe4SkxWQ","children":[{"id":"216","parent":"215","text":"Ciclosporina + corticoides + azatioprina (triple inmunosupresion)","guid":"Jn_FHtybTOGDiEgfP61FVg","children":[]},{"id":"217","parent":"215","text":"Mortalidad alta sin tratamiento (mediana sobrevida 5 meses)","guid":"84XOSsz9SWuIAXHHrs0pug","children":[]}]},{"id":"218","parent":"212","text":"MIOCARDITIS EOSINOFILICA","guid":"TWqWIUFKRkqMsRUfS7q9eQ","children":[{"id":"219","parent":"218","text":"Corticoides + suspension del agente causal","guid":"VTUSdzQcQQ2phvi9NvHOOw","children":[]}]},{"id":"220","parent":"212","text":"ICI (inhibidores checkpoint)","guid":"lFLNBM_2T5e0rcF4e_A9vg","children":[{"id":"221","parent":"220","text":"SUSPENSION INMEDIATA del ICI (decision conjunta onco + cardio)","guid":"9F1MI0FZSBmWmOtd65SQsA","children":[]},{"id":"222","parent":"220","text":"Prednisona 1-2 mg/kg/dia (hasta 500 mg IV si fulminante)","guid":"r8GyAHwZTTG2GPR8-kyo0g","children":[]},{"id":"223","parent":"220","text":"Refractario: micofenolato, infliximab, abatacept, tacrolimus","guid":"ZKkUh8VzSNKCxHvvybi7wA","children":[]}]},{"id":"224","parent":"212","text":"EVIDENCIA LIMITADA en miocarditis viral: no usar inmunosupresion de rutina","guid":"KNtHhB7zSRGlDK2yMQlIEQ","children":[]}]},{"id":"225","parent":"198","text":"MANEJO ARRITMIAS","guid":"XFJOMKgURjmSX69X6FO05Q","children":[{"id":"226","parent":"225","text":"Antiarritmicos segun tipo (amiodarona en TV)","guid":"CH9WpCwWT46VpdeVUAmG5w","children":[]},{"id":"227","parent":"225","text":"Marcapasos transitorio si BAV de alto grado","guid":"M2rioHFrTcqClEY-IfbK-w","children":[]},{"id":"228","parent":"225","text":"DAI: solo si arritmia ventricular documentada con riesgo vital una vez resuelto proceso inflamatorio","guid":"YqsjavtWREmz8HrOF95xyg","children":[]},{"id":"229","parent":"225","text":"EVITAR DAI profilactico en fase aguda (no predice riesgo a largo plazo)","guid":"GMimpWz5S5K8sCTsiPfjEw","children":[]}]},{"id":"230","parent":"198","text":"SHOCK CARDIOGENICO / FORMAS FULMINANTES","guid":"CGRDEgPgR1Wa3xXRXfczOg","children":[{"id":"231","parent":"230","text":"Inotrópicos (dobutamina, milrinona)","guid":"Tr453yxvRLq58XcbIW0Yqg","children":[]},{"id":"232","parent":"230","text":"ECMO veno-arterial (soporte biventricular)","guid":"DueT4xmiSjWqEXawEBQoYQ","children":[]},{"id":"233","parent":"230","text":"IMPELLA (descarga VI)","guid":"3o9lCCHXTrm3sv3CQ6tSDQ","children":[]},{"id":"234","parent":"230","text":"Balon intra-aortico (menos eficaz en miocarditis fulminante)","guid":"nH9IK-PET5ayQUvPrayG7A","children":[]},{"id":"235","parent":"230","text":"TRASPLANTE CARDIACO si no hay recuperacion de funcion en 6-12 meses","guid":"bf4lXAX1TwSgNuStrBQxXw","children":[]},{"id":"236","parent":"230","text":"DISPOSITIVO ASISTENCIA VENTRICULAR (DAV) como puente a trasplante","guid":"_L4I6HgOTYy6Sw34D6WcFQ","children":[]}]}]},{"id":"237","parent":"0","text":"Miocarditis Post-Vacuna ARNm","guid":"n0CxeEs0SRKOMu__pZ9p-w","children":[{"id":"238","parent":"237","text":"DATOS EPIDEMIOLOGICOS","guid":"kL7wJgFQR7ytwHc_4JdYmg","children":[{"id":"239","parent":"238","text":"Predominante: hombres 16-30 anos, dosis 2","guid":"JikV8SgMSrqoNms0AjsnbA","children":[]},{"id":"240","parent":"238","text":"mRNA-1273 (Moderna) > BNT162b2 (Pfizer): 2-4x mayor riesgo","guid":"vCAnNxhxRJe7ARS3gZ4HDw","children":[]},{"id":"241","parent":"238","text":"Incidencia: ~1-10/100.000 dosis en grupo de mayor riesgo","guid":"B_vI3am_S9emhStxEWn9fg","children":[]},{"id":"242","parent":"238","text":"Inicio: 2-7 dias post-dosis (mediana 2-3 dias)","guid":"sAsIR18_QVyZXD8V6Al2YA","children":[]}]},{"id":"243","parent":"237","text":"PRESENTACION CLINICA","guid":"z9yl25lBQSeT3-BMFuacAA","children":[{"id":"244","parent":"243","text":"Dolor toracico + elevacion troponina + cambios ECG","guid":"sDqGi0exSdyTytR-KnGvsw","children":[]},{"id":"245","parent":"243","text":"Ecocardiografia: disfuncion leve o normal","guid":"ME2q50aVROW-sY9qERHPrA","children":[]},{"id":"246","parent":"243","text":"RM: LGE subepicardico lateral (mismo patron viral)","guid":"fEkG9AL7QXCyBcXRWLI7Vg","children":[]}]},{"id":"247","parent":"237","text":"CURSO Y PRONOSTICO","guid":"241etkHkSk2uLyrtXiXUwA","children":[{"id":"248","parent":"247","text":"Benigno >95% de casos","guid":"XUEemQ5HQnqB18noRIfPmw","children":[]},{"id":"249","parent":"247","text":"Recuperacion completa en semanas-meses","guid":"xkSWpgBmRMqimAlU8VHytg","children":[]},{"id":"250","parent":"247","text":"Hospitalizacion breve (2-4 dias)","guid":"OKXjK4o-QxKBQur3-u59Hg","children":[]},{"id":"251","parent":"247","text":"Casos graves o fulminantes: <1%","guid":"DFWPZjM9QkSwBlZJwuwpMA","children":[]},{"id":"252","parent":"247","text":"Seguimiento RM a 3-6 meses recomendado","guid":"msPwECpzRjeBYIY_ipz09w","children":[]}]},{"id":"253","parent":"237","text":"MANEJO","guid":"BKgUrPQZRrajfXR5kdUGeQ","children":[{"id":"254","parent":"253","text":"AINE (ibuprofeno 400-600 mg c/8h x 1-2 semanas)","guid":"vXK-GlcMQ4qwIwiG8RLBJA","children":[]},{"id":"255","parent":"253","text":"Reposo fisico estricto 3-6 meses","guid":"cTGkj_a0TxOsLHB-Im4qsg","children":[]},{"id":"256","parent":"253","text":"Corticoides en casos seleccionados (refractarios o graves)","guid":"22ZEu8xGRO6l01_HCRtkMA","children":[]},{"id":"257","parent":"253","text":"NO contraindicar vacunacion en otros grupos etarios","guid":"caRzixoNThKGEj3nBMydKw","children":[]}]},{"id":"258","parent":"237","text":"BALANCE RIESGO-BENEFICIO","guid":"GSf3czB_RjK-sI2pwdUTVA","children":[{"id":"259","parent":"258","text":">40 anos: beneficios vacunacion >>> riesgo miocarditis (10-100x menor riesgo que miocarditis por COVID-19)","guid":"zVDg_8hkSnWeNN62RntubA","children":[]},{"id":"260","parent":"258","text":"Hombres 12-17a: unica poblacion donde relacion riesgo-beneficio debatida","guid":"cdlLGZHgThe92JYqH-_twA","children":[]}]}]},{"id":"261","parent":"0","text":"Miocarditis por Inhibidores de Checkpoint (ICI)","guid":"rSmCVwHrSGqv4rTJAHbFcQ","children":[{"id":"262","parent":"261","text":"EPIDEMIOLOGIA","guid":"8JdZ8gWfT7ezxCDZyyMv1Q","children":[{"id":"263","parent":"262","text":"Incidencia: 0.5-2% (subestimada por subdiagnostico)","guid":"wsSGE6kjTae7hfhGDZSuMg","children":[]},{"id":"264","parent":"262","text":"Mortalidad: hasta 40-50% en formas fulminantes","guid":"OdPNmny-RcGG2M_zNxOZgA","children":[]},{"id":"265","parent":"262","text":"Combinacion CTLA4+PD1 (ipilimumab+nivolumab): mayor riesgo","guid":"Oup_nk3LSvOZn58sN6_Zew","children":[]},{"id":"266","parent":"262","text":"Inicio: mediana 30 dias post-inicio (rango 1 dia - 5 meses)","guid":"W-QQU9MFRCyYK_vJgXXGkQ","children":[]}]},{"id":"267","parent":"261","text":"PRESENTACION","guid":"j4E4YtgmRkaohkgq6gbkVQ","children":[{"id":"268","parent":"267","text":"Forma leve: troponina elevada + cambios ECG sin sintomas","guid":"lxx30PbHSx2aesrLXr3hrA","children":[]},{"id":"269","parent":"267","text":"Forma grave: IC aguda, shock, BAV, arritmias ventriculares","guid":"g0z54iPjTt2hDXMu8zoz-g","children":[]},{"id":"270","parent":"267","text":"Puede asociarse a miositis, hepatitis, encefalitis (sindrome ICI multiorga)","guid":"xK5-l70HS5GPi9vQTqBI4g","children":[]}]},{"id":"271","parent":"261","text":"ALGORITMO DIAGNOSTICO (ASCO/ESC)","guid":"79BHpaycTt2rAR0SDAwFeg","children":[{"id":"272","parent":"271","text":"Troponina + ECG PREVIO a inicio de ICI (basal obligatorio)","guid":"ay3eUkmkS4W0KsG5cvEpPg","children":[]},{"id":"273","parent":"271","text":"Troponina + ECG en cada ciclo (primeros 3 ciclos)","guid":"GGKZszqqRpeISWYBY8WiSw","children":[]},{"id":"274","parent":"271","text":"Sospecha: troponina >3x LSN + nuevos sintomas","guid":"s9LQefmhT-m2g8IPcTvWrg","children":[]},{"id":"275","parent":"271","text":"RM cardiaca + biopsia si disponible","guid":"dsM2KNUsRZ-HXnoIReAzJA","children":[]}]},{"id":"276","parent":"261","text":"MANEJO SEGUN GRADO","guid":"e1hAw0rkSCGQgt-AT0WOqg","children":[{"id":"277","parent":"276","text":"GRADO 1 (asintomatico, biomarkers leves): vigilar, continuar ICI con monitorizacion","guid":"3-DZfr-FQ-Kd8PC6z3L03Q","children":[]},{"id":"278","parent":"276","text":"GRADO 2 (sintomas leves, troponina moderada): suspender ICI, prednisona 0.5-1 mg/kg","guid":"d7ZBY-JxTRue4OUp6AkOzw","children":[]},{"id":"279","parent":"276","text":"GRADO 3-4 (sintomas graves, disfuncion VI): SUSPENSION DEFINITIVA + prednisona 1-2 mg/kg IV","guid":"u81XymmWQEm711P0Zu1Ctw","children":[]},{"id":"280","parent":"276","text":"REFRACTARIO: pulsos metilprednisolona 1g/dia x 3 + micofenolato/tacrolimus/infliximab","guid":"9qmVq-1dQ6-v-IKMV39RpQ","children":[]},{"id":"281","parent":"276","text":"ECMO si fulminante","guid":"KU7es5Z_QcOnOFFIAzR74w","children":[]}]}]},{"id":"282","parent":"0","text":"Pronostico","guid":"taCTkekiSg27IOW936Dz3A","children":[{"id":"283","parent":"282","text":"FORMA VIRAL LEVE","guid":"CkO5PTj8TMuZqHb2yW8_Sg","children":[{"id":"284","parent":"283","text":"Recuperacion completa: 50-70%","guid":"dpJox1BLRp-Gm-FxkdTTyA","children":[]},{"id":"285","parent":"283","text":"Cardiomiopatia dilatada cronica: 20-30%","guid":"-hDoTceWRTy-Gu-ksDF8rA","children":[]},{"id":"286","parent":"283","text":"Trasplante o muerte: 5-10%","guid":"tVdLm8SmQtWSo04OUtHhJg","children":[]}]},{"id":"287","parent":"282","text":"MIOCARDITIS FULMINANTE (PARADOJA DE LA FULMINANTE)","guid":"YMPDNYVvSeWNYaX1G0hhfA","children":[{"id":"288","parent":"287","text":"Mortalidad fase aguda elevada (requiere soporte intensivo)","guid":"zB0bUOpPSjuWBgq42U5jHw","children":[]},{"id":"289","parent":"287","text":"Si SOBREVIVE fase aguda: recuperacion completa >90%","guid":"hokv5XV2SmGhq0hQzTBggA","children":[]},{"id":"290","parent":"287","text":"Pronostico a largo plazo MEJOR que forma no-fulminante","guid":"iHoAOczGSD-CZW0HyTDrOw","children":[]}]},{"id":"291","parent":"282","text":"FACTORES DE MAL PRONOSTICO","guid":"NbwORqP3S_adZ8EfEaTs8w","children":[{"id":"292","parent":"291","text":"FEVI <30% al ingreso","guid":"8bECUrMCRK6vaSA0_RoPKA","children":[]},{"id":"293","parent":"291","text":"Ausencia de recuperacion de FEVI a los 6 meses","guid":"UmejO9uJS_i0xfarF0QHiw","children":[]},{"id":"294","parent":"291","text":"Sincope o TV sostenida al inicio","guid":"-cQj-eY-QkqEA7aBz8KpFA","children":[]},{"id":"295","parent":"291","text":"BAV completo","guid":"RshJlTTZQCK3R7qIMDO7Ug","children":[]},{"id":"296","parent":"291","text":"Afeccion biventricular","guid":"3fKn11q8TJWlxNKVOnTP_g","children":[]},{"id":"297","parent":"291","text":"Miocarditis de celulas gigantes (sin inmunosupresion)","guid":"oxWLff8-SI-0wVxU46InQQ","children":[]},{"id":"298","parent":"291","text":"ICI fulminante","guid":"Eydrsde9TUi54WM96y4MgQ","children":[]}]},{"id":"299","parent":"282","text":"SEGUIMIENTO RECOMENDADO","guid":"PYImjCciQgOGgZ-aJ4fEfQ","children":[{"id":"300","parent":"299","text":"ECO a 1-3-6 meses","guid":"47fQ4qDOQRyrm6CwxA0Oyg","children":[]},{"id":"301","parent":"299","text":"RM cardiaca a 3-6 meses (evaluacion cicatriz)","guid":"H8SjphixTTWetLxXohXo0Q","children":[]},{"id":"302","parent":"299","text":"Holter si arritmias documentadas","guid":"n4AcoYOHS1e04KTHkTp9VQ","children":[]},{"id":"303","parent":"299","text":"Considerar DAI si FEVI <35% a los 6 meses (valorar individualmente)","guid":"gSaMeYXoQaeU5NSEOeV7hA","children":[]}]}]},{"id":"304","parent":"0","text":"Consideraciones Geriatricas","guid":"JmvguW6GS9evh_M47TgPsA","children":[{"id":"305","parent":"304","text":"DIFERENCIAS EPIDEMIOLOGICAS","guid":"6a8538ynQ926V_xZ6zA3pw","children":[{"id":"306","parent":"305","text":"Adulto mayor: causa autoinmune > viral","guid":"VHvAj21xS1OSTmE3l4-5wA","children":[]},{"id":"307","parent":"305","text":"Fármacos (ICI en oncologia, clozapina en psiquiatria geriatrica) son causa frecuente y subestimada","guid":"ywGGlI1QTtWNFox_o2ojzA","children":[]},{"id":"308","parent":"305","text":"Chagas cronico: considerar en pacientes de zona endemica (norte Chile)","guid":"Gcz_EF_sSE2Q4dHc81U4DQ","children":[]}]},{"id":"309","parent":"304","text":"PRESENTACION ATIPICA","guid":"s2yDMm2-SXqoe00DJ-COiw","children":[{"id":"310","parent":"309","text":"Disnea o fatiga sin dolor toracico","guid":"-l360DOJSa69nuWKkArhOw","children":[]},{"id":"311","parent":"309","text":"Confusion o deterioro funcional subagudo (sindrome geriatrico)","guid":"9ropNZfpSJOrJaVXgqI6Tw","children":[]},{"id":"312","parent":"309","text":"Edema de extremidades atribuido a otra causa","guid":"vFRxq4NlS5qR-w5OqxPhqg","children":[]},{"id":"313","parent":"309","text":"Troponina elevada en screening VGI o pre-cirugia","guid":"is1kwuQmQ3iyYvs25yhBqQ","children":[]}]},{"id":"314","parent":"304","text":"ICI EN ADULTO MAYOR ONCOGERIATRICO","guid":"BVJRcCKSSR2S2kHnEpxr0w","children":[{"id":"315","parent":"314","text":"Consideracion CRITICA: cancer + ICI en adulto mayor -> monitorizar SIEMPRE","guid":"NjHTYYNwT32pe0iT2tTyng","children":[]},{"id":"316","parent":"314","text":"Cardiooncologia: valoracion conjunta antes de inicio y cada ciclo","guid":"QrnS1ttjTzOqptzXbre2Bg","children":[]},{"id":"317","parent":"314","text":"Fragilidad limita tolerancia a inmunosupresion intensiva","guid":"RA1S1gncT6OBlrjbkzgKbA","children":[]}]},{"id":"318","parent":"304","text":"LIMITACIONES DIAGNOSTICAS","guid":"KBNjbcB4TRKLb8xHjSRAGg","children":[{"id":"319","parent":"318","text":"Biopsia con riesgo aumentado en fragiles (hemorragia, perforacion)","guid":"RQtrqL0EScu8QoJ0bwl-uw","children":[]},{"id":"320","parent":"318","text":"RM cardiaca: marcapasos, claustrofobia, funcion renal (gadolinio)","guid":"5lMrzuMhRYmTCyZEf-M8LQ","children":[]},{"id":"321","parent":"318","text":"Menor tolerancia al contraste yodado (coronariografia)","guid":"wRPzNkZ5RmuUJa9EM91Txw","children":[]}]},{"id":"322","parent":"304","text":"LIMITACIONES TERAPEUTICAS","guid":"OuBxKBb7SRG9IOvtZyNrkw","children":[{"id":"323","parent":"322","text":"ECMO/IMPELLA: evaluar segun estado funcional y deseos del paciente","guid":"ncpbtXHtQoK5m9F7Fa6CGA","children":[]},{"id":"324","parent":"322","text":"Fragilidad severa: puede contraindicar soporte mecanico invasivo","guid":"e99bTX6BTQS-6DS7k8BgXQ","children":[]},{"id":"325","parent":"322","text":"Betabloqueadores: titular cuidadosamente (bradicardia, caidas)","guid":"Hwf5kTnbQMyU4_jAYp_fzw","children":[]},{"id":"326","parent":"322","text":"SGLT2i: ajustar si TFG <30","guid":"Yzisd1OtRFyNq1Ll9ykzLg","children":[]},{"id":"327","parent":"322","text":"Discusion de objetivos de cuidado (pronostico realista)","guid":"2bhC3EhkS9uYx41l2n_MCg","children":[]}]},{"id":"328","parent":"304","text":"CHAGAS GERIATRICO","guid":"FpW__OAgRjyvDkqc9eKmUA","children":[{"id":"329","parent":"328","text":"Miocarditis cronica + fibosis extensa","guid":"zhV15LysReq8mtKGTbt4mw","children":[]},{"id":"330","parent":"328","text":"BCRD + HBAI en ECG clasico","guid":"Y7v4zY6IRRyDo_5EzEpCwA","children":[]},{"id":"331","parent":"328","text":"Aneurisma apical VI (trombo y ACV)","guid":"0SFruKsuSXqINpmuegRY-g","children":[]},{"id":"332","parent":"328","text":"IC terminal puede ser presentacion final","guid":"6gmTDGj7TVG1B9DxJ9ePDw","children":[]}]}]},{"id":"333","parent":"0","text":"Perlas Clinicas","guid":"tKbxmtqVRYi0lgGR5yYKxQ","children":[{"id":"334","parent":"333","text":"PERLA 1 - CORONARIOGRAFIA PRIMERO: en dolor toracico + troponina + supradesnivel ST en adulto >40a o con FRCV, SIEMPRE descartar SCA con coronariografia antes de diagnosticar miocarditis. Una coronaria normal + LGE no isquemico en RM = miocarditis. No asumir sin imagenes.","guid":"y6mqAcxnT1-Lq5XktkchMA","children":[]},{"id":"335","parent":"333","text":"PERLA 2 - LGE SUBEPICARDICO: el patron de realce tardio subepicardico o midmiocaridico en RM cardiaca es el sello de miocarditis. Diferencia clave con IAM (transmural + subendocardico). Un patron de LGE que NO respeta territorio coronario debe sugerir miocarditis.","guid":"oX_JGu88S0WsCdZax-7THQ","children":[]},{"id":"336","parent":"333","text":"PERLA 3 - PARADOJA FULMINANTE: la miocarditis fulminante tiene PEOR pronostico inmediato pero MEJOR a largo plazo. El VI no dilatado en fase aguda se recupera mejor. Justifica soporte agresivo con ECMO/IMPELLA incluso en pacientes seleccionados de edad avanzada.","guid":"lL_f-5P5RY236jaMW9Gepw","children":[]},{"id":"337","parent":"333","text":"PERLA 4 - ICI = EMERGENCIA CARDIACA: troponina elevada en paciente con nivolumab/pembrolizumab/ipilimumab es miocarditis hasta demostrar lo contrario. SUSPENDER ICI + corticoides altas dosis URGENTE. La demora aumenta mortalidad. Mortalidad ICI miocarditis = hasta 50%.","guid":"uI_0LShESuyjIOtByeIwXg","children":[]},{"id":"338","parent":"333","text":"PERLA 5 - CLOZAPINA Y MIOCARDITIS: toda clozapina nueva debe vigilar troponina + PCR en semanas 1-4 de inicio. Miocarditis por clozapina ocurre tipicamente en la semana 2-3. Si troponina sube -> SUSPENDER clozapina inmediatamente. Mortalidad alta si no se actua rapido.","guid":"pfPCKLXzQ1uelbdVGFe-Kg","children":[]},{"id":"339","parent":"333","text":"PERLA 6 - VACUNA ARNm EN >40a: el riesgo de miocarditis por vacuna ARNm en adultos >40 anos es muy bajo y el beneficio de la vacuna supera ampliamente al riesgo. La miocarditis por COVID-19 es 10-100x mas frecuente y grave que la post-vacuna. No contraindicar vacunacion.","guid":"z1GegaxqRo6yhtfngmK_qA","children":[]},{"id":"340","parent":"333","text":"PERLA 7 - RESTRICCION FISICA OBLIGATORIA: todo paciente con miocarditis DEBE hacer reposo de ejercicio 3-6 meses. Es la medida mas efectiva para prevenir arritmias y muerte subita. No negociar en atletas. Reinicio gradual solo tras normalizacion de troponina + RM sin inflamacion activa.","guid":"_JU47pDtSxCfeC-3Cdgz6w","children":[]},{"id":"341","parent":"333","text":"PERLA 8 - LYME Y BAV COMPLETO: bloqueo AV completo en adulto joven + epidemiologia compatible (zonas boscosas, exantema) = Lyme hasta demostrar lo contrario. Marcapaso transitorio + doxiciclina. Resolucion espontanea tras antibioticos en mayoria.","guid":"gQueS_a1TieG5V_2eko3-w","children":[]},{"id":"342","parent":"333","text":"Referencias","guid":"ThHb_ONwTeO0tvfE-s-JdA","children":[{"id":"343","parent":"342","text":"1. Cooper LT Jr. Myocarditis. N Engl J Med. 2009;360(15):1526-1538. PMID: 19357408","guid":"FGZILdoOQdCogkSQh7isNw","children":[]},{"id":"344","parent":"342","text":"2. Ferreira VM, Schulz-Menger J, Holmvang G, et al. Cardiovascular Magnetic Resonance in Nonischemic Myocardial Inflammation: Expert Recommendations. J Am Coll Cardiol. 2018;72(24):3158-3176. (Lake Louise Criteria 2018)","guid":"7RMu4MLkRlaOzOZWUQh2aA","children":[]},{"id":"345","parent":"342","text":"3. Aretz HT, Billingham ME, Edwards WD, et al. Myocarditis. A histopathologic definition and classification. Am J Cardiovasc Pathol. 1987;1(1):3-14. (Dallas Criteria)","guid":"nAO_e2ySSjiREkq1kZZ4nQ","children":[]},{"id":"346","parent":"342","text":"4. Caforio AL, Pankuweit S, Arbustini E, et al. Current state of knowledge on aetiology, diagnosis, management, and therapy of myocarditis: a position statement of the ESC Working Group on Myocardial and Pericardial Diseases. Eur Heart J. 2013;34(33):2636-2648.","guid":"1BucPPg8Ta6omb8ekvgsCQ","children":[]},{"id":"347","parent":"342","text":"5. Bozkurt B, Colvin M, Cook J, et al. Current Diagnostic and Treatment Strategies for Specific Dilated Cardiomyopathies: A Scientific Statement From the AHA. Circulation. 2016;134(23):e579-e646.","guid":"VI4G1MDqRXqWVOoAqxmibg","children":[]},{"id":"348","parent":"342","text":"6. Sarda L, Colin P, Boccara F, et al. Myocarditis in patients with clinical presentation of myocardial infarction and normal coronary angiograms. J Am Coll Cardiol. 2001;37(3):786-792. (Sarda MINOCA)","guid":"x1MXqi1iSh-fiuzywjTyvw","children":[]},{"id":"349","parent":"342","text":"7. Johnson DB, Balko JM, Compton ML, et al. Fulminant Myocarditis with Combination Immune Checkpoint Blockade. N Engl J Med. 2016;375(18):1749-1755. (ICI myocarditis seminal)","guid":"8is9Wyt0R167Bq-43zNovA","children":[]},{"id":"350","parent":"342","text":"8. Ammirati E, Frigerio M, Adler ED, et al. Management of Acute Myocarditis and Chronic Inflammatory Cardiomyopathy: An Expert Consensus Document. Circ Heart Fail. 2020;13(11):e007405.","guid":"-nDThlV3QIOSniqgDGX8QA","children":[]},{"id":"351","parent":"342","text":"9. Bozkurt B, Kamat I, Hotez PJ. Myocarditis With COVID-19 mRNA Vaccines. Circulation. 2021;144(6):471-484.","guid":"3GPSqzNdSs2W6i3IdPJpuw","children":[]},{"id":"352","parent":"342","text":"10. Imazio M, Cooper LT. Management of myopericarditis. Expert Rev Cardiovasc Ther. 2013;11(2):193-201.","guid":"aBp5ojPrR7yjGwGg-bsaaA","children":[]}]}]}]},"node_count":352,"relations":[],"cross_references":[],"specialty":"UCI/Medicina Crítica","folder":"Entidades clínicas/UCI-Medicina Crítica","filename":"VM_Paro_Cardiaco_Six-dial_iPad","id":"map_256","resolved_references":[]}