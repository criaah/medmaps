86HtmfgSYbdag","children":[]}]},{"id":"49","parent":"0","text":"3. ABUSO PATRIMONIAL/ECONÓMICO","guid":"Aty3WunvRdakgPGoezxsdg","children":[{"id":"50","parent":"49","text":"Manifestaciones más frecuentes","guid":"Nrvi0yN0RnijT1hfS9TDdg","children":[{"id":"51","parent":"50","text":"Falsificación de firmas","guid":"VF1XbU4gSyOzj9nrnK2qcQ","children":[]},{"id":"52","parent":"50","text":"Consentimiento por error, fuerza o dolo","guid":"_OWfM4fHT3KtBtkGBG5Qug","children":[]},{"id":"53","parent":"50","text":"Apropiación de pensión o dineros","guid":"cM0gYGYrQqCiHglvcWUNfg","children":[]},{"id":"54","parent":"50","text":"A fin de mes PM no accede a nada del dinero cobrado","guid":"mg4f5RlBQSqPovJmGCXsjQ","children":[]}]},{"id":"55","parent":"49","text":"RIESGO INMINENTE (figura CL)","guid":"yLld4CPvQxaoqiq2dRz6ww","children":[{"id":"56","parent":"55","text":"PM propietaria relegada al último rincón","guid":"ZnJo9W0ES1SfURa9zFmcYw","children":[]},{"id":"57","parent":"55","text":"O expulsada de su propia casa","guid":"k5vhUF8ORMG0BLEl5kznEw","children":[]},{"id":"58","parent":"55","text":"O con desplazamiento restringido en su vivienda","guid":"Wgm9AFENR3SoEt7NHZcQiw","children":[]},{"id":"59","parent":"55","text":"Pregunta clave → \"¿quién decide en qué pieza duerme usted?\"","guid":"KRdLjNuuR3yOyqG7vWhdCA","children":[]}]}]},{"id":"60","parent":"0","text":"4. MALTRATO FÍSICO","guid":"I5QYgQHTQbCiOgtND2qOnA","children":[{"id":"61","parent":"60","text":"Resultados → dolor, lesiones, discapacidad, MUERTE","guid":"KzzY1PxzRGevPWRgpUUWyw","children":[]},{"id":"62","parent":"60","text":"Manifestaciones (espectro amplio)","guid":"5Dee57FkQp6cCgqD1nSK8w","children":[{"id":"63","parent":"62","text":"Empujones, pellizcos, quemaduras, encierros","guid":"NAf7KjZQR9CZG8nE7_-RVg","children":[]},{"id":"64","parent":"62","text":"Medicamentos excesivos/incorrectos","guid":"KkNjBOZVSn6GnRBJr5Q3Lw","children":[]},{"id":"65","parent":"62","text":"Sujeción mecánica inadecuada","guid":"jY_4VtAZTDWqY3j8LbW3fw","children":[]},{"id":"66","parent":"62","text":"Golpes","guid":"pQBC7vGMSByv6axx3EOd4w","children":[]}]},{"id":"67","parent":"60","text":"Señales clínicas","guid":"vRik7lwlSN6A2vDcP2NfHQ","children":[{"id":"68","parent":"67","text":"Caídas frecuentes/lesión INEXPLICABLE","guid":"YqVV2zADQLGBHod6qG582w","children":[]},{"id":"69","parent":"67","text":"Heridas/fracturas que no concuerdan con explicaciones","guid":"dea_i6glREqwHrkBIaDm6w","children":[]},{"id":"70","parent":"67","text":"Lesiones OCULTAS → cuello, axilas, espalda, parte interna muslos","guid":"ba_eopQ9SOyWRzLw2XRd6g","children":[]},{"id":"71","parent":"67","text":"Marcas tipo dedos en pecho/cuello/boca → sujeción manual","guid":"ZrTjpRJ8QEaBe-x2aDCFQA","children":[]},{"id":"72","parent":"67","text":"Hematomas en zonas protegidas","guid":"eyvVLVSnQm6XCy6bHIec6Q","children":[]},{"id":"73","parent":"67","text":"Cortes en zonas atípicas","guid":"OSK_ceZkTNO0rlvKDCTglQ","children":[]},{"id":"74","parent":"67","text":"Quemaduras geométricas o por inmersión","guid":"zPgnOUkVT2K_x704JpKAuw","children":[]}]},{"id":"75","parent":"60","text":"Calificación legal CL","guid":"B-9dJFX5RbKh36yPbexkQQ","children":[{"id":"76","parent":"75","text":"Lesiones GRAVES → no puede actividades cotidianas >30 días","guid":"ItBUGLHxTf-eZV_ZVfQ8uw","children":[]},{"id":"77","parent":"75","text":"Lesiones MENOS GRAVES → recuperación antes de 30 días","guid":"xCE5gv7MSWm8LgayjzJJ1Q","children":[]},{"id":"78","parent":"75","text":"Lesiones LEVES → no requieren tratamiento importante ni cirugía","guid":"IloK-KCZRZqclISxQszU9w","children":[]}]},{"id":"79","parent":"60","text":"Agravante → penas ↑ si víctima PM con dependencia","guid":"czKf9z6RQvKcYLJOjtMCsQ","children":[]},{"id":"80","parent":"60","text":"Trato DEGRADANTE → amarrar a poste, no cambiar pañales","guid":"G_z19IypQSehKEnDOThzBw","children":[]}]},{"id":"81","parent":"0","text":"5. ABUSO SEXUAL","guid":"ZXpcjqswRN6AkFSs6R2VTg","children":[{"id":"82","parent":"81