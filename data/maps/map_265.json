Co-clVBisupVonMBAwj5Ew","children":[]}]},{"id":"33","parent":"27","text":"- Mecanismo","guid":"","children":[{"id":"34","parent":"33","text":"- Efecto en la absorción de hierro","guid":"T0HLWTif5gdG5_n7XUaSRg","children":[]}]},{"id":"35","parent":"27","text":"- Tratamiento","guid":"","children":[{"id":"36","parent":"35","text":"- Revierte con administración de riboflavina","guid":"VuBBkjssT4oT6U9zT2R0WA","children":[]}]}]},{"id":"37","parent":"0","text":"## DEFICIENCIA\\NDE TIAMINA","guid":"","children":[{"id":"38","parent":"37","text":"- Características","guid":"","children":[{"id":"39","parent":"38","text":"- Síndrome raro de la niñez","guid":"BWoNw1jFNz17XHHSckiXHw","children":[]},{"id":"40","parent":"38","text":"- Diabetes mellitus","guid":"","children":[]},{"id":"41","parent":"38","text":"- Sordera neurosensorial","guid":"","children":[]},{"id":"42","parent":"38","text":"- Anemia megaloblástica","guid":"","children":[]},{"id":"43","parent":"38","text":"- En ocasiones, trombocitopenia","guid":"WxSHhxD-B1FYC-CufO-Kxg","children":[]}]},{"id":"44","parent":"37","text":"- Prevalencia","guid":"","children":[{"id":"45","parent":"44","text":"- Niños de ascendencia asiática","guid":"atOfd2fOzqRlK2HwOFRsrQ","children":[]}]},{"id":"46","parent":"37","text":"- Causa","guid":"","children":[{"id":"47","parent":"46","text":"- Mutación bialélica del gen SLC19A2 (cromosoma 1q23.3)","guid":"RhPiax5v-rYvAtkWQsQ1KA","children":[]}]},{"id":"48","parent":"37","text":"- Tratamiento","guid":"","children":[{"id":"49","parent":"48","text":"- Administración de por vida de tiamina (25-100 mg/día)","guid":"XjPK23l0R09Vy-8BaMNncA","children":[]}]}]},{"id":"50","parent":"0","text":"## DEFICIENCIA DE VITAMINA C\\N(ÁCIDO ASCÓRBICO)","guid":"","children":[{"id":"51","parent":"50","text":"- Manifestaciones\\Nhematológicas","guid":"","children":[{"id":"52","parent":"51","text":"- Anemia variable: macrocítica, normocítica o microcítica","guid":"Sdb6OStuYgJrzGCEGRjFkg","children":[]},{"id":"53","pa