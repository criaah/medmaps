":"60","text":"Dosis 2 mg/día, inicio 0.5-1 mg/día","guid":"7wVgSF4zSo-1RwMy5Gil7w","children":[]},{"id":"66","parent":"60","text":"EA: aumento peso 8.0% vs 3.1%, acatisia 7.4% vs 1.0%","guid":"e2dCGBhUQ_uEF8af7Ms7yA","children":[]}]},{"id":"67","parent":"51","text":"AGITACIÓN EN DEMENCIA ALZHEIMER → ÚNICO antipsicótico aprobado","guid":"gi28mI38QUKyNaPB7zGkfw","children":[{"id":"68","parent":"67","text":"Aprobación FDA mayo 2023","guid":"_EsSDuIiTWOWsPF_NAOBMA","children":[]},{"id":"69","parent":"67","text":"Medicamento de MANTENIMIENTO → NO usar PRN","guid":"D1fMW58FQ5-H2lL6TmSIhg","children":[]},{"id":"70","parent":"67","text":"Dosis 2-3 mg/día, inicio 0.5 mg/día","guid":"zfRLiY4dRMWcOhMYA2VTNQ","children":[]},{"id":"71","parent":"67","text":"Estudio pivotal Lee 2023 (JAMA Neurol)","guid":"ufgXbeN9RLGWxF6noTYxfw","children":[{"id":"72","parent":"71","text":"RCT 12 semanas, 345 pacientes, edad media 74 años","guid":"yRrRljkHTWKtZIXDXuewJA","children":[]},{"id":"73","parent":"71","text":"CMAI diff -5.32 (IC -8.77 a -1.87, p=0.003)","guid":"uW5G50nGQAaA6qCbt-1iGw","children":[]},{"id":"74","parent":"71","text":"Cohen d = 0.35 → tamaño efecto pequeño-moderado","guid":"Zv8t3maZQ2KaOrzInWtXng","children":[]},{"id":"75","parent":"71","text":"Completaron 86.8% brexpiprazol vs 88.9% placebo","guid":"-qCH4up-RqyEE0SqkRZ_Cw","children":[]},{"id":"76","parent":"71","text":"Discontinuación EA 5.3% vs 4.3%","guid":"MEjquoMaToeiUU_w3rKR3Q","children":[]}]},{"id":"77","parent":"67","text":"Grossberg 2019 → 2 RCTs fase III","guid":"DZI6Q0L-Tkidy66bhnurKg","children":[{"id":"78","parent":"77","text":"Estudio 1 → 2 mg/d significativo (diff -3.77, p=0.040)","guid":"CceJuZLyQMqgFNk2oout1w","children":[]},{"id":"79","parent":"77","text":"1 mg/d NO significativo","guid":"s8IEwOPoRTinil8DkM0Czg","children":[]},{"id":"80","parent":"77","text":"Estudio 2 flexible → NS global, pero subgrupo 2 mg significativo","guid":"uvc1EJwQTwi_UE3JIui12w","children":[]}]},{"id":"81","parent":"67","text"