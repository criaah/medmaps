TUe3Fr3g","children":[]}]},{"id":"155","parent":"152","text":"Reevaluación 6MWT/SPPB intermedia","guid":"81MJ824xRz6HXgdl3xIPIg","children":[]},{"id":"156","parent":"152","text":"Inmunonutrición si oncológica (días -7 a -1)","guid":"Mq4vFsAdTMqfjE3rLs_Lsw","children":[]}]},{"id":"157","parent":"0","text":"Semana -2 a 0","guid":"6TKDaGqWRcu-ErhvxBxWGQ","children":[{"id":"158","parent":"157","text":"Mantención (no ↑ carga últimos 3-5 días)","guid":"Ha3NN-P4SuKJBpjp5579uQ","children":[]},{"id":"159","parent":"157","text":"Repaso pre-Qx","guid":"vgkAN_rxSvyfuK21RO9oig","children":[]},{"id":"160","parent":"157","text":"Ejercicio respiratorio intensivo","guid":"jLbCyCw6Ssal1OqkAe9rjQ","children":[]},{"id":"161","parent":"157","text":"Día -1: ayuno preoperatorio segun ERAS","guid":"zg9EPu_4QaSA29kY75wQuQ","children":[]},{"id":"162","parent":"157","text":"Carbohydrate loading si aplica","guid":"kyNDG-IbRFqpY_MgOToptw","children":[]}]},{"id":"163","parent":"0","text":"Post-Qx","guid":"A4wvysGLQ2aBQfjabBd2FQ","children":[{"id":"164","parent":"163","text":"Continuar con rehabilitación post-Qx (Fase 1)","guid":"gmZFEOrBQH66nf88WSQ_Bg","children":[]},{"id":"165","parent":"163","text":"Alumno YA conoce el programa → mayor adherencia","guid":"mTYA1kI5R_K-H8JLqGu_yQ","children":[]},{"id":"166","parent":"163","text":"Efecto educación previa","guid":"IWSukJpsSsGL5pQzvie9iA","children":[]}]},{"id":"167","parent":"0","text":"LOS: ↓ 1-3 días","guid":"l8WKUQ7xSbSgyFFkmDVe4g","children":[]},{"id":"168","parent":"0","text":"Complicaciones pulmonares: ↓ 30-50% (cir. torácica/abdominal alta)","guid":"DhpgKg7ORA2pMzXEz0N4FQ","children":[]},{"id":"169","parent":"0","text":"Complicaciones globales: OR 0.5-0.7 (cir. colorrectal AM)","guid":"pMJFAj6DR0ajGpGbDLaDHQ","children":[]},{"id":"170","parent":"0","text":"6MWT pre-Qx: +20-50 m","guid":"vKglPaw4Qty0UGCvcSi4bw","children":[]},{"id":"171","parent":"0","text":"Mortalidad 30d: tendencia favorable","guid":"3QxI141mSLOVVlkjkzni_w","children":[]},