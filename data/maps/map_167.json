fkR9OMG8z13nm_tQ","children":[]},{"id":"141","parent":"139","text":"Velocidad de marcha → <0,7 m/s aumenta riesgo","guid":"sogVsahSRWSjHg6tg6jQsQ","children":[]},{"id":"142","parent":"139","text":"SPPB → más completa","guid":"k1MyqD6BR32Z-MqJu8O8wg","children":[]},{"id":"143","parent":"139","text":"Estación unipodal → tiempo equilibrio sobre 1 pie","guid":"EICG3i91SkWejNQ-X7RdIg","children":[]},{"id":"144","parent":"139","text":"Tinetti → escala clásica","guid":"dTzVqC4qSi6oda597nZVyw","children":[]}]},{"id":"145","parent":"102","text":"Procedimiento\\NTUG","guid":"m6Lo8OvVQFy30rOfyLRIiw","children":[{"id":"146","parent":"145","text":"Paciente sentado","guid":"fJYinVSVRwmBsp6tDy8Rcw","children":[]},{"id":"147","parent":"145","text":"Ponerse de pie","guid":"CifV-t7tRu6gRDJGEQIn5A","children":[]},{"id":"148","parent":"145","text":"Caminar 3 metros","guid":"9GcpmQRnSdC9wHCwYsI1Pw","children":[]},{"id":"149","parent":"145","text":"Volver y sentarse","guid":"gp1MzgNpQgSuu_cWPQDPLQ","children":[]},{"id":"150","parent":"145","text":"Cronometrar → >15 s alto riesgo","guid":"ZO_bXvu4SaKM7-a_Bprvag","children":[]}]},{"id":"151","parent":"102","text":"Exámenes\\Ncomplementarios","guid":"BlrzXjFbSr2yqvcndX_aUQ","children":[{"id":"152","parent":"151","text":"Laboratorio\\Nrazonable","guid":"WvQsDNBVSRy2_UtS3ZzDrQ","children":[{"id":"153","parent":"152","text":"Hemograma + VHS","guid":"egMhAl3UQi-kEjwNMOvLiA","children":[]},{"id":"154","parent":"152","text":"Vitamina B12 (propiocepción)","guid":"QZfQu6TcTq6N77rFE8Tptg","children":[]},{"id":"155","parent":"152","text":"TSH, función renal, electrolitos, glicemia","guid":"N42UcNyhTCGPa59ksj3Lxg","children":[]},{"id":"156","parent":"152","text":"Vitamina D","guid":"4TCnXH6oSzyXg7OwGEcFIA","children":[]}]},{"id":"157","parent":"151","text":"Exámenes\\Ndirigidos","guid":"qmfxbm-HSgqhxps0D_9IlQ","children":[{"id":"158","parent":"157","text":"Holter → caída con compromiso de conciencia sin prodromos (no rutina)","guid":"FJ8DOh0gSHCc3RABFP8gHg","children":[]},{"id":"159","parent":"157","text":"Ecocardiograma → si soplos","guid":"tqsl_-KuQdK5A_zX4-ZKdw","children":[]},{"id":"160","parent":"157","text":"TC cerebro → golpe cefálico o focalidad","guid":"goc9KW8vTaG0XtMm9rkDLQ","children":[]},{"id":"161","parent":"157","text":"Audiometría / 8° par → solo si vértigo verdadero","guid":"HFKtw4lISxyMHCkhn-_oAA","children":[]}]}]}]},{"id":"162","parent":"0","text":"Manejo —\\NIntervención\\Nmultifactorial","guid":"eHuPltsJQ5W2kkT-pbzBkA","children":[{"id":"163","parent":"162","text":"Estrategia con mejor evidencia","guid":"p_CfDR4rTM-LrYANuWpAIA","children":[]},{"id":"164","parent":"162","text":"Componentes\\Nobligatorios","guid":"3iyYOpCFR6a7kgJ2NnmbtQ","children":[{"id":"165","parent":"164","text":"1. Ejercicios de fuerza y equilibrio (EEII especialmente)","guid":"smwRPdbWTby_U1f3zJhQrQ","children":[]},{"id":"166","parent":"164","text":"2. Educación en uso de ayudas técnicas","guid":"5swhKPLmTDKljiqxSsAKlw","children":[]},{"id":"167","parent":"164","text":"3. Revisión y ajuste de fármacos (suspender PIM)","guid":"FG_PkQtuTgCgeTZ2noKO5g","children":[]},{"id":"168","parent":"164","text":"4. Adecuación del ambiente (modificaciones hogar)","guid":"U_V3mWLlRNysnlGRiJrwNw","children":[]},{"id":"169","parent":"164","text":"5. Prevención y tratamiento del ortostatismo","guid":"EFt8ylvzSKCSwJy18rDSmw","children":[]},{"id":"170","parent":"164","text":"6. Tratamiento causas oftalmológicas (cirugía catarata)","guid":"lw6FCtzATmSc7nBMBmbuyg","children":[]},{"id":"171","parent":"164","text":"7. Detección y tratamiento de osteoporosis","guid":"0fCv2T_2TK2deVhPbyCy0w","children":[]},{"id":"172","parent":"164","text":"8. Tratamiento podológico + calzado adecuado","guid":"sFKY7EMfQEeMifebz2z2nw","children":[]},{"id":"173","parent":"164","text":"9. Vitamina D (en deficientes)","guid":"garmfG8_TKGU4SFcve21KQ","children":[]}]},{"id":"174","parent":"162","text":"Ejercicio — intervención\\Naislada más efectiva","guid":"SJGRZiW_R4il2_fn0CbTtg","children":[{"id":"175","parent":"174","text":"Fortalecimiento EEII + entrenamiento equilibrio y marcha","guid":"TkW6CQLaQpq2-7Xir9_Oww","children":[]},{"id":"176","parent":"174","text":"Únicos con evidencia para prevenir caídas","guid":"FYDFcBtoRkuT_CghXzP5Rg","children":[]}]},{"id":"177","parent":"162","text":"Seguridad\\Nen el hogar","guid":"PsxBv2v4SFq-hSAyWB138Q","children":[{"id":"178","parent":"177","text":"Iluminación adecuada","guid":"wmanxTT2RpiBrZOkzIOaGA","children":[]},{"id":"179","parent":"177","text":"Baño → barras de apoyo + antideslizante","guid":"oc7fAtcbSY6bL1l1KanOxw","children":[]},{"id":"180","parent":"177","text":"Dormitorio → interruptor accesible","guid":"FTQZjsGUT32giQflxkY1mw","children":[]},{"id":"181","parent":"177","text":"Retirar alfombras + evitar cables","guid":"u6htYmt4Rw2VkZXuEyYGog","children":[]},{"id":"182","parent":"177","text":"Escaleras con pasamano firme","guid":"y2QmwUfFQhiy9MyxW7l_ew","children":[]}]},{"id":"183","parent":"162","text":"Calzado\\Nrecomendado","guid":"1WUA_6kRRVelMs-WrOXt2g","children":[{"id":"184","parent":"183","text":"Cerrado con buena sujeción","guid":"EePg65isRqKgEdA2snvLSw","children":[]},{"id":"185","parent":"183","text":"Suela antideslizante","guid":"CEc8habDRKCRvp0uAbv4TQ","children":[]},{"id":"186","parent":"183","text":"Taco bajo","guid":"MbzGD-WXRAamuFiAie-ohg","children":[]}]},{"id":"187","parent":"162","text":"Calzado\\Nde riesgo\\N(evitar)","guid":"zDi1f-kJRDGxFOAymhSRng","children":[{"id":"188","parent":"187","text":"Pantuflas","guid":"emwKtretSiG8g4cZ5jUaxw","children":[]},{"id":"189","parent":"187","text":"Sandalias sueltas","guid":"KPbz5O1hQZ2j7wQvr5AChQ","children":[]},{"id":"190","parent":"187","text":"Zapatos abiertos atrás","guid":"8RspoIiWSJSaMwrsGWEG9g","children":[]},{"id":"191","parent":"187","text":"Descalzo o solo calcetines","guid":"1jBpXd2kTzmF3yhU2PQClA","children":[]}]},{"id":"192","parent":"162","text":"Vitamina D\\Ny caídas","guid":"aklJnO0_TQiJBnJ836nKLw","children":[{"id":"193","parent":"192","text":"NO tamizaje universal (Task Force 2018)","guid":"eTUHJyFCSCCnvk_Idi7yXA","children":[]},{"id":"194","parent":"192","text":"Suplementar si déficit / fragilidad / sarcopenia / institucionalizado","guid":"kIDClb1EQJ-kxGjjyVxxCA","children":[]},{"id":"195","parent":"192","text":"Meta >30 ng/mL","guid":"KzD4y4s2Rhqh0XBoFpGp6Q","children":[]},{"id":"196","parent":"192","text":"Dosis carga 50.000 UI/sem × 4-8 sem","guid":"tzkA-SCCSCyCKpJcWKjPQQ","children":[]},{"id":"197","parent":"192","text":"Mantención 800 UI/día","guid":"25eJ5llkT9mkh7ydXop_dw","children":[]},{"id":"198","parent":"192","text":"EVITAR bolo masivo 500.000 UI → AUMENTA riesgo de caída","guid":"TvKxOCvkSMuBisGPO8LuCw","children":[]}]}]},{"id":"199","parent":"0","text":"Consecuencias\\Nde las caídas","guid":"Xmyc5RtmSZCBGavDVFwDDQ","children":[{"id":"200","parent":"199","text":"Espectro","guid":"2NEthyT2SIKHIPKRp4zyww","children":[{"id":"201","parent":"200","text":"Sin lesión","guid":"HEbXVa8vTl2iGNeSrltErA","children":[]},{"id":"202","parent":"200","text":"Lesiones menores → equimosis, dolor","guid":"CimxKI8US9WjP6Ny2qG91A","children":[]},{"id":"203","parent":"200","text":"Lesiones mayores → fracturas, TEC, hematoma subdural","guid":"yyXqH-HeRBq3f69EIsPlvg","children":[]},{"id":"204","parent":"200","text":"Miedo a caer","guid":"BeaDR8yPTsWFJY3Ct_n1zg","children":[]},{"id":"205","parent":"200","text":"Inmovilidad → dependencia → muerte","guid":"GfJN41OnSRWhwlgVln4U0w","children":[]}]},{"id":"206","parent":"199","text":"Fractura de cadera —\\Nejemplo paradigmático","guid":"aJ6xNhByRTGODZ7oeEiFlw","children":[{"id":"207","parent":"206","text":"Demencia 30%","guid":"osLF8ZEFTCC_8mnGCpaOXA","children":[]},{"id":"208","parent":"206","text":"Delirium intrahospitalario 55%","guid":"4LK-ematQyKRGmLaEgpoJg","children":[]},{"id":"209","parent":"206","text":"Recuperan funcionalidad previa 30-50%","guid":"JMO_vucNTCaSZYbLBZcG9w","children":[]},{"id":"210","parent":"206","text":"NO vuelven a caminar 20%","guid":"lh-DYeHfQKORW7xtb73UgQ","children":[]},{"id":"211","parent":"206","text":"Mortalidad intrahospitalaria 4%","guid":"fP_nUF9NSWORfpffaYXzGQ","children":[]},{"id":"212","parent":"206","text":"Mortalidad al año 25%","guid":"Gaf4J5YOR7alLCFwG09thg","children":[]},{"id":"213","parent":"206","text":"Institucionalización al año 25%","guid":"Umb71T0eS2aZo0fT4gae2A","children":[]},{"id":"214","parent":"206","text":"Manejo conjunto geriatría + traumatología → ortogeriatría","guid":"duWAdBs9TLWT28GBKBsGyg","children":[]}]},{"id":"215","parent":"199","text":"Miedo a caer","guid":"LKNvyFiyThqEjrf0QF2ydQ","children":[{"id":"216","parent":"215","text":"Preocupación que lleva a evitar actividades","guid":"5KkIWlF-S1GaC-kVTHc_fg","children":[]},{"id":"217","parent":"215","text":"Antes \"síndrome post-caída\", ahora afecta a quienes no han caído","guid":"CeZKs-D5TrWZmHp3B9K5Zg","children":[]},{"id":"218","parent":"215","text":"Sin caídas previas → 30%","guid":"Y7jh_zKDQH-W8o3Y9aQR0A","children":[]},{"id":"219","parent":"215","text":"Con caídas previas → 70%","guid":"QlDcMFm8RzW0d1Yp9CnaBw","children":[]},{"id":"220","parent":"215","text":"Círculo vicioso","guid":"jO_CORNyTxuTqaF1STvT9A","children":[{"id":"221","parent":"220","text":"Miedo → inactividad → ↓ fuerza → alteración balance → ↑ riesgo → nuevas caídas","guid":"Zyy6BnerSjeflsZNNDVW1A","children":[]}]},{"id":"222","parent":"215","text":"Consecuencias → peor calidad de vida, depresión, institucionalización","guid":"E8xbi41PQKKCCozhNi7FvQ","children":[]}]}]},{"id":"223","parent":"0","text":"Preguntas Autoestudio\\N(oficiales Dra. Paola Fuentes)","guid":"kl95qsVGQt6nrXtOH2TrnA","children":[{"id":"224","parent":"223","text":"1. ¿Por qué una caída en una persona mayor debe considerarse un síndrome geriátrico y no un evento aislado?","guid":"GgrVMfpHQAGUeaSNqdRK4g","children":[]},{"id":"225","parent":"223","text":"2. La mayoría de las caídas son multifactoriales. Analice los factores intrínsecos y extrínsecos que determinan el riesgo de caer y cómo interactúan entre sí","guid":"4lMM92BFSKCz9hilCXuLvQ","children":[]},{"id":"226","parent":"223","text":"3. Analice el rol de la polifarmacia en el riesgo de caídas. ¿Qué grupos farmacológicos se asocian con mayor riesgo y por qué?","guid":"2Z99UmK9TaSGvoOeDtxg3g","children":[]},{"id":"227","parent":"223","text":"4. Describa qué elementos busca en la anamnesis, examen físico y exámenes complementarios de una persona mayor que ha tenido una caída. ¿Cuál es el rol de la Valoración Geriátrica Integral?","guid":"LFSV9tEGQfeBLcwcZPTBDA","children":[]},{"id":"228","parent":"223","text":"5. Si un paciente mayor menciona que ha tenido 2 o más caídas en el último año, ¿qué medidas instauraría para prevenir nuevas caídas?","guid":"mEZ31Z59QcWCgCsdQO7B4g","children":[]},{"id":"229","parent":"223","text":"6. Caso clínico: Mujer 85a, HTA + trastorno sueño, en Losartán 100 mg + HCTZ 25 mg + Zopiclona 7,5 mg. Vive sola en casa 2 pisos, dormitorio arriba, escala sin baranda, muchas alfombras (no las quiere sacar). Autovalente AIVD intra, pero varias caídas y no sale sola por miedo. Cognición conservada. Analice factores de riesgo e intervenciones de prevención","guid":"OVRmhgDeQ-qjUIhoqVH-5A","children":[]},{"id":"230","parent":"223","text":"7. ¿Qué medidas han demostrado evidencia en prevenir caídas?","guid":"ftxp5LiYQwK1S3UuLhLjFw","children":[]},{"id":"231","parent":"223","text":"8. ¿Qué tipo de ejercicios recomendaría para prevenir caídas en una persona mayor?","guid":"gVQq7EjZR_am4tfESEU6uQ","children":[]}]},{"id":"232","parent":"0","text":"Caso clínico ejemplo (Pregunta 6)\\N— análisis sugerido","guid":"_SiDFEtCQQ2vFRcNvGBklQ","children":[{"id":"233","parent":"232","text":"Factores intrínsecos","guid":"sPBZ16xtR4iQ0JswvWtDoQ","children":[{"id":"234","parent":"233","text":"Edad 85a","guid":"oU3IViz4RMuOpjeNceubQA","children":[]},{"id":"235","parent":"233","text":"HTA","guid":"uEAw18z2R92J9rBoFkaFVQ","children":[]},{"id":"236","parent":"233","text":"Miedo a caer (con caídas previas)","guid":"nUwYc-2_QvSuc8MzeojNkw","children":[]}]},{"id":"237","parent":"232","text":"Factores extrínsecos","guid":"N2qrKmajRCGx_3lLHqMP_Q","children":[{"id":"238","parent":"237","text":"Vivienda 2 pisos con dormitorio arriba","guid":"Quy12tJMQoio8ZL_86dS5w","children":[]},{"id":"239","parent":"237","text":"Escala sin baranda","guid":"Z0zPu_wBSLy_vNEYT5Kpbw","children":[]},{"id":"240","parent":"237","text":"Alfombras","guid":"_Vtw45ttQLunc7O5Qe5H1Q","children":[]}]},{"id":"241","parent":"232","text":"Fármacos de riesgo","guid":"ox1drKXiQ1ioHYsK0qAE9Q","children":[{"id":"242","parent":"241","text":"Losartán + HCTZ → ortostatismo","guid":"oeiU2mOyTBmKEUcZRHjKhQ","children":[]},{"id":"243","parent":"241","text":"Zopiclona → SNC + caídas nocturnas → revisar suspensión gradual","guid":"Sh6Q9iuPQ3qg9Q4UWRtOCA","children":[]}]},{"id":"244","parent":"232","text":"Intervenciones","guid":"ByCDJJQ0QDivcmvaHQGKmA","children":[{"id":"245","parent":"244","text":"Suspender/disminuir Zopiclona (deprescribir, manejar insomnio no farmacológico)","guid":"5vbGpFJ3TPmIPgGbU9abLQ","children":[]},{"id":"246","parent":"244","text":"Reevaluar HTA → riesgo ortostático con HCTZ; considerar monoterapia con Losartán o ajustar dosis","guid":"ITan4WRbQrafX82pOuMNHg","children":[]},{"id":"247","parent":"244","text":"Adecuación hogar → instalar barandas escala, retirar/asegurar alfombras (o trasladar dormitorio a 1er piso)","guid":"Bnw2yWeBQniLVBDqKG9K6g","children":[]},{"id":"248","parent":"244","text":"Kinesiología → ejercicio fuerza EEII + equilibrio","guid":"bgLHN4o_Q4mD19EXCOzpoA","children":[]},{"id":"249","parent":"244","text":"Vitamina D si déficit","guid":"ZqsqKGtcRb6IPlxNEZVCpQ","children":[]},{"id":"250","parent":"244","text":"Tamizar osteoporosis (FRAX/DXA)","guid":"V0KREwAZQe-yvvhc-ukGfA","children":[]},{"id":"251","parent":"244","text":"Tratar miedo a caer → TCC + reincorporación gradual a salidas","guid":"jsWiCOH1Qy-Ikh26BiBG7A","children":[]}]}]},{"id":"252","parent":"0","text":"Evidencia complementaria\\N(papers oficiales)","guid":"a4I93dTtQWil4H2q-UnNeA","children":[{"id":"253","parent":"252","text":"Leung JAMA 2024 → \"JAMA Patient Page\" sobre prevención de caídas; ejercicio + revisión de medicación + ambiente como mensajes clave","guid":"C7pOmLCISui3dCrc1Sityg","children":[]},{"id":"254","parent":"252","text":"Ganz NEJM 2020 → revisión clínica de referencia: tamizaje, evaluación multifactorial, ejercicio y deprescripción","guid":"AUk0hnjmRx6bLU5U81DSrA","children":[]},{"id":"255","parent":"252","text":"Croswell AFP 2012 → resumen para atención primaria","guid":"jLkzdoYASXCqYa-1ibaI1w","children":[]},{"id":"256","parent":"252","text":"Iglesias Medicine Spain 2022 → caídas y fractura de cadera, integración ortogeriátrica","guid":"JwqmcBqRSyuVJd6ktmpvng","children":[]}]},{"id":"257","parent":"0","text":"Perlas Clínicas","guid":"uGy4Hgc2Tga3lmMQYvExCg","children":[{"id":"258","parent":"257","text":"Perla 1: Si no preguntas por caídas, no aparecen → 4 preguntas en TODA consulta ≥65a (n°, lesión, inestabilidad, miedo)","guid":"iRqj-UytS6i6KC7Gj45rxA","children":[]},{"id":"259","parent":"257","text":"Perla 2: TUG >15 s = alto riesgo → 1-2 min sin equipamiento, mínimo razonable en APS","guid":"Hkvh9_slRD6xQ4w4kJYG-w","children":[]},{"id":"260","parent":"257","text":"Perla 3: Ortostatismo ≥20 PAS o ≥10 PAD a 3 min, con o sin síntomas → inestabilidad sin mareo basta","guid":"OFFoaRkSSKuCHMubstNnLA","children":[]},{"id":"261","parent":"257","text":"Perla 4: Polifarmacia es el factor modificable más importante → BZD, Z, AD, AP, relajantes, diuréticos, anti-HTA; ajustes recientes son gatillo","guid":"f3SAqC6OSoCyGJhcj808pA","children":[]},{"id":"262","parent":"257","text":"Perla 5: 80% caídas en el hogar y mayoría accidentales (no sincopales) → VGI+ambiente+fármacos rinden más que Holter rutinario","guid":"P88tFESxS8iHNt1ruGb2qA","children":[]},{"id":"263","parent":"257","text":"Perla 6: Intervención multifactorial > cualquier componente aislado → combo mínimo viable en APS = kine + revisión fármacos + adaptación hogar + visión + osteoporosis","guid":"kVnAMDCPR0WG0_bN4aN8aA","children":[]},{"id":"264","parent":"257","text":"Perla 7: Vitamina D solo en déficit/fragilidad/institucionalizado → 50.000 UI/sem × 4-8 sem + 800 UI/día; BOLO 500.000 UI AUMENTA riesgo","guid":"ICWjJhFsRmOxVu8jydKWpQ","children":[]},{"id":"265","parent":"257","text":"Perla 8: 30% de los mayores SIN caídas previas ya tienen miedo a caer → preguntar \"¿ha dejado de hacer cosas por miedo a caerse?\"","guid":"4kYkCk8dQme_DH75bUgVig","children":[]},{"id":"266","parent":"257","text":"Perla 9: Fractura cadera = 25% mortalidad al año, 25% institucionalización, 20% no vuelve a caminar → manejo ortogeriátrico + osteoporosis si fractura previa","guid":"5ek2ZzInSMO6MQy3xvLgQg","children":[]},{"id":"267","parent":"257","text":"Perla 10: Las pantuflas son enemigas en geriatría → recomendar calzado cerrado, sujeción, suela antideslizante, taco bajo","guid":"q7YTB1BpRdGJ5WpNq34-mg","children":[]}]},{"id":"268","parent":"0","text":"Conceptos examinados\\N(Evaluaciones SGGCh 2026)","guid":"k61GLz1ZT4eHvh5AFwvPsQ","children":[{"id":"269","parent":"268","text":"Evaluacion M2","guid":"G4xkxMOHTVyRqBJe3r3rtg","children":[{"id":"270","parent":"269","text":"P5 (FR intrinseco mayor riesgo): Parkinson encabeza el grupo de ALTO riesgo (OR 2,7-2,9) -> mayor que deficit visual; jerarquizar tamizaje en pacientes con Parkinson","guid":"ruz2211GSAyG9CPklGBw9g","children":[]},{"id":"271","parent":"269","text":"P8 (caedor recurrente): >=2 caidas en 1 ano o 1 caida con lesion -> indicacion formal de evaluacion + INTERVENCION MULTIFACTORIAL (no solo un componente aislado)","guid":"BGp5wl2oSYqocVfUcFdLwA","children":[]},{"id":"272","parent":"269","text":"P19 (mayoria son accidentales): \"accidental\" = NO sincopal (NO es \"sin causa\"); sincope <5%; lesion seria 5-10% (no 30%); causa unica es falso (multifactorial = regla)","guid":"JgJOoExdTPykJmwNEy3D-w","children":[]}]},{"id":"273","parent":"268","text":"Evaluacion Final (transversales)","guid":"wy51pfoHTOGJH0wJJrrlGw","children":[{"id":"274","parent":"273","text":"No hay items directos; los conceptos de Eval M2 cubren las perlas Parkinson + multifactorial + naturaleza accidental","guid":"mBdIuXfEQyOejfCW9SjRWw","children":[]}]}]},{"id":"275","parent":"0","text":"Referencias (bibliografía oficial\\NDra. Paola Fuentes)","guid":"vL9PIKdtSJOv6NEc_4NbGg","children":[{"id":"276","parent":"275","text":"1. Leung PB, Alexander JT, Ouchida KE. Falls Prevention for Older Adults. JAMA. 2024;331(16):1409-1410. doi:10.1001/jama.2023.26942","guid":"rBcdHZSCTceKOSxlS6iZlw","children":[]},{"id":"277","parent":"275","text":"2. Ganz DA, Latham NK. Prevention of falls in community-dwelling older adults. N Engl J Med. 2020;382(8):734-743. doi:10.1056/NEJMcp1903252","guid":"1hxE8E0zTXGWzUlYwzFJHg","children":[]},{"id":"278","parent":"275","text":"3. Croswell J, Shin YR. Prevention of falls in community-dwelling older adults. Am Fam Physician. 2012;86(12):1135-1136","guid":"eSELJUUkSgWTqk4s45jFbw","children":[]},{"id":"279","parent":"275","text":"4. Iglesias AL, Sánchez LAH, Mateos-Nozal J, Nebreda MLA. Falls and hip fracture. Medicine (Spain). 2022;13(62):3659-3670. doi:10.1016/j.med.2022.08.018","guid":"ERcIW0x4Tf6htbzJ_L1PIQ","children":[]}]}]},"node_count":279,"relations":[],"cross_references":[],"specialty":"Cardiología","folder":"Entidades clínicas/MKSAP - 18/Cardiología","filename":"1. Factores de riesgo de enfermedad cardiovascular","id":"map_167","resolved_references":[]}