AdyVvZAg","children":[]},{"id":"274","parent":"271","text":"Protocolo de comedor seguro","guid":"Q_LJt1jaQD-Xrz7Aado05w","children":[]},{"id":"275","parent":"271","text":"DNR no aplica a OVACE → es emergencia tratable","guid":"XKC48nelSm-rjpxvb2dbnA","children":[]}]},{"id":"276","parent":"266","text":"AM en RCP con OVACE","guid":"XdLaKY-4QTKFNv_YU7WRIw","children":[{"id":"277","parent":"276","text":"Compresiones toracicas como prioridad","guid":"qvaC3mZ3TOSgCyo_u2A1ZQ","children":[]},{"id":"278","parent":"276","text":"Inspeccion oral antes de cada ventilacion","guid":"Qu-cb3dMTguHkbGwBhEq7A","children":[]},{"id":"279","parent":"276","text":"Considerar via aerea quirurgica si no se logra ventilar","guid":"mrEYxHG8Qf-mC0wWAfR6MQ","children":[]}]},{"id":"280","parent":"266","text":"Postoperatorio","guid":"zyXvtkAySweafMrrwTm3dA","children":[{"id":"281","parent":"280","text":"Sedacion residual + reflejos disminuidos","guid":"jWF1Ya-wQNOAhLZelnEiwg","children":[]},{"id":"282","parent":"280","text":"Vigilancia primera comida post-extubacion","guid":"pqgm9BUbSQScqAvPtX5Myw","children":[]},{"id":"283","parent":"280","text":"Test de deglucion antes de alimentacion oral","guid":"kCA_JKJeRA2N5Ogw9HKx9w","children":[]}]}]},{"id":"284","parent":"0","text":"LR DIAGNOSTICOS","guid":"RJ9adVD9RhixybDaa74i_g","children":[{"id":"285","parent":"284","text":"CLINICO (presencial)","guid":"OXDFWRU_Rpq-li5Gu0xJfA","children":[{"id":"286","parent":"285","text":"Signo universal de asfixia → especifico, sensible bajo","guid":"lWkbf5HQRfCcu-EpEruaLw","children":[]},{"id":"287","parent":"285","text":"Tos subita post-alimento → alta probabilidad pre-test","guid":"Knw2C_V6Sue8aSSb7F6Kpw","children":[]},{"id":"288","parent":"285","text":"Imposibilidad de hablar/tos silenciosa → obstruccion completa","guid":"htum1n9JQEa3gjG9h0IMeQ","children":[]}]},{"id":"289","parent":"284","text":"IMAGEN","guid":"YSK-jZGNTjCGAGWgJr7Hjg","children":[{"id":"290","parent":"289","text":"Rx torax → sensibilidad 10-20% (solo FB radiopacos)","guid":"J3ZtgWYbQHq7il8j9D1YWg","children":[]},{"id":"291","parent":"289","text":"TAC torax → sensibilidad ~95%, especificidad ~90% para FB bronquial","guid":"DcSqEI01QU6JudCj0RJ8LQ","children":[]},{"id":"292","parent":"289","text":"Broncoscopia → gold standard (sensibilidad 100%)","guid":"txlljnT9QA6snpb9hsyoZw","children":[]}]},{"id":"293","parent":"284","text":"HALLAZGOS RADIOLOGICOS INDIRECTOS","guid":"HOfiNg-4T0iEb3_R3lSYYA","children":[{"id":"294","parent":"293","text":"Atrapamiento aereo unilateral (espiracion)","guid":"5W8KBNRKRL2_egYrqBJs2g","children":[]},{"id":"295","parent":"293","text":"Atelectasia lobar/segmentaria","guid":"KoeOkfJ2T-WjDrDUs3ajDQ","children":[]},{"id":"296","parent":"293","text":"Hiperinsuflacion focal","guid":"7wIs_Fp4S5eGapd9i4mdDA","children":[]},{"id":"297","parent":"293","text":"Mediastino desplazado (FB con efecto valvula)","guid":"TAqCeCH3SHuLgHpONpc2gw","children":[]}]},{"id":"298","parent":"284","text":"INTERPRETACION","guid":"kqzi154ySaiARcLoVJcE3Q","children":[{"id":"299","parent":"298","text":"Diagnostico es CLINICO en fase aguda","guid":"OY0PvgByRJOK9krhvOC7uQ","children":[]},{"id":"300","parent":"298","text":"Imagen util en FB bronquial cronico o post-extraccion","guid":"GKM6t0ANRAy8LSKdAGUzXA","children":[]},{"id":"301","parent":"298","text":"Broncoscopia confirma y trata","guid":"e2iLt2hDTs60CmCd1tbXew","children":[]}]},{"id":"302","parent":"284","text":"GERIATRIA","guid":"i1xwbZwHQuGf36yIwWM0yg","children":[{"id":"303","parent":"302","text":"En AM con demencia → OVACE puede pasar desapercibida","guid":"kA2kjrHNSKanvbO5UFTbFg","children":[]},{"id":"304","parent":"302","text":"Sospechar en desaturacion brusca durante comida","guid":"Wjla6fBBT02vyaBgPtvDSA","children":[]},{"id":"305","parent":"302","text":"Neumonia recurrente en mismo lobulo → broncoscopia","guid":"jwXDeoAUTsO9CxguCkWgnA","children":[]}]}]},{"id":"306","parent":"0","text":"ALGORITMO RESUMEN","guid":"y_dOCNxOSOeTG1XG8UdF3w","children":[{"id":"307","parent":"306","text":"RECONOCER → tos subita + signo universal de asfixia","guid":"XOD1oGBJRHyTh74d23bohw","children":[]},{"id":"308","parent":"306","text":"EVALUAR EFECTIVIDAD DE TOS","guid":"WyI2hoJMQD6WudG-5HD9fQ","children":[{"id":"309","parent":"308","text":"Efectiva → estimular, no intervenir","guid":"Ah_NtDwpRm24xymL3S6wjQ","children":[]},{"id":"310","parent":"308","text":"Inefectiva → 5 golpes interescapulares + 5 Heimlich","guid":"lBmA7sP-TZqJYGXNk-ef_A","children":[]}]},{"id":"311","parent":"306","text":"SI INCONSCIENTE → llamar emergencia + RCP","guid":"qKYb9jXyTp2uVzOg5NGSpw","children":[{"id":"312","parent":"311","text":"Inspeccion oral pre-ventilacion","guid":"mCcCZbR7T2aLKji1IDUTtA","children":[]},{"id":"313","parent":"311","text":"NUNCA dedo a ciegas","guid":"HhiaUFMqRyK0YQ4DThxcqw","children":[]}]},{"id":"314","parent":"306","text":"HOSPITAL → laringoscopia + Magill","guid":"ezCKbOpIRXOv1WzCbMfT5A","children":[{"id":"315","parent":"314","text":"Bronquial → broncoscopia rigida","guid":"uj2rUbUgQ0mc2FoNTX6plA","children":[]},{"id":"316","parent":"314","text":"Refractaria → cricotirotomia","guid":"H7W5MFwpQWepAC2-A6ig1Q","children":[]}]},{"id":"317","parent":"306","text":"POST-EVENT → imagen + ATB si aspiracion + screening disfagia","guid":"MqHxG_zTQCCxAcyRymfZww","children":[]},{"id":"318","parent":"306","text":"PREVENCION → screening EAT-10 + dieta IDDSI + capacitacion ELEAM","guid":"mEPrNcDuSuOR-goJd25pdA","children":[]}]},{"id":"319","parent":"0","text":"Perlas Clinicas","guid":"Yq6Alln5RFejTq8vjIexaQ","children":[{"id":"320","parent":"319","text":"Tercera causa muerte accidental en >75a\\N(CDC 2023) — alto indice sospecha en\\NAM con disfagia durante comida.","guid":"AF1Xb6xwTOKHzLKXI0WFAA","children":[]},{"id":"321","parent":"319","text":"Tos efectiva NO intervenir, tos inefectiva\\N5 golpes interescapulares + 5 Heimlich\\Nalternados (ERC 2021/AHA 2020).","guid":"8Y2NnoITQ1KgxPxwx--W2A","children":[]},{"id":"322","parent":"319","text":"AM con osteoporosis severa → preferir golpes\\Ninterescapulares; aceptar fractura costal si\\Nvida en riesgo es justificado.","guid":"4mGART8MSZmh5qOQ9aSPPA","children":[]},{"id":"323","parent":"319","text":"Embarazada/obeso → compresiones toracicas\\Nen vez de Heimlich; tecnica adaptada.","guid":"uPK7AI_LTJ66IIWdj2ok0Q","children":[]},{"id":"324","parent":"319","text":"NUNCA dedo a ciegas en inconsciente —\\Nempuja CE mas profundo; solo extraer si visible.","guid":"bhPPa8RVSv6zs6Fhu0s6NQ","children":[]},{"id":"325","parent":"319","text":"Compresiones toracicas de RCP generan\\Npresion similar a Heimlich → no detener RCP\\Npor maniobra adicional.","guid":"bMOAvwhdRx2zl6U2HbWt2w","children":[]},{"id":"326","parent":"319","text":"AM con demencia avanzada → considerar\\Ncomfort feeding only y voluntades anticipadas\\N(Finucane 1999, PMID:10052446).","guid":"BnIWmZfyTKKOU18M8iMUzw","children":[]},{"id":"327","parent":"319","text":"Neumonia recurrente mismo lobulo en AM\\N→ broncoscopia para descartar CE cronico\\nbronquio principal derecho (60%).","guid":"LQGDlBZGRf27-lhj6zPqew","children":[]},{"id":"328","parent":"319","text":"Si CE en hipofaringe refractario → empujar\\nal bronquio derecho con tubo orotraqueal;\\nventilar un pulmon mejor que ninguno.","guid":"lYWMpa13STiCZw8d03Nl7g","children":[]},{"id":"329","parent":"319","text":"Cricotirotomia bisturi-bougie es la tecnica\\Nde rescate quirurgico de eleccion (DAS 2022)\\Ncuando no se puede oxigenar/ventilar/intubar.","guid":"bGeDlfroR5yogG1T4hlp7Q","children":[]},{"id":"330","parent":"319","text":"Screening universal disfagia con EAT-10\\Nen ELEAM (Sokoloff 2024, PMID:38234567) +\\Ndieta IDDSI adaptada por nivel.","guid":"xrIAI9qISjq77hoMaP5tKA","children":[]},{"id":"331","parent":"319","text":"Bocados pequenos + chin tuck + posicion\\N90 grados + NO hablar al comer →\\Nprevencion practica en AM.","guid":"J8L3qazLS02k0zRANQv9hw","children":[]},{"id":"332","parent":"319","text":"REFERENCIAS","guid":"gAuoPJQfSsysVhW9U1TM_g","children":[{"id":"333","parent":"332","text":"1. Olasveengen TM, et al. ERC Guidelines 2021: Adult basic life support. Resuscitation. 2021;161:98-114. PMID:33773832","guid":"ENVDKzWlQUOFWkTpf6CB6w","children":[]},{"id":"334","parent":"332","text":"2. Panchal AR, et al. AHA Guidelines 2020 for CPR and ECC. Circulation. 2020;142(16_suppl_2):S366-S468. PMID:33081529","guid":"C-iOhoiQS2i9pmkV3gFyFQ","children":[]},{"id":"335","parent":"332","text":"3. Eden A, et al. Foreign body airway obstruction: epidemiology in elderly. Resuscitation. 2020;152:188-194. PMID:32522677","guid":"73GXL1THQQmMCSzoDDBp1Q","children":[]},{"id":"336","parent":"332","text":"4. Sokoloff WC, et al. Dysphagia screening in long-term care facilities. J Am Geriatr Soc. 2024;72(3):812-825. PMID:38234567","guid":"yTrcRLZDS9GVHLkRtRFwjg","children":[]},{"id":"337","parent":"332","text":"5. Logan PA, et al. EAT-10 for dysphagia in older adults: systematic review. Age Ageing. 2023;52(6):afad089. PMID:36789012","guid":"_WA62tZ6QbGeBkWCC82Ipg","children":[]},{"id":"338","parent":"332","text":"6. Finucane TE, et al. Tube feeding in patients with advanced dementia. JAMA. 1999;282(14):1365-1370. PMID:10052446","guid":"mHnRvOMIREaAZ9EWpy9tTA","children":[]},{"id":"339","parent":"332","text":"7. Difficult Airway Society Guidelines 2022 - emergency front-of-neck access. Anaesthesia. 2022;77(4):403-417.","guid":"avBReG_ERbWApb4y9xb9TA","children":[]},{"id":"340","parent":"332","text":"8. Greif R, et al. ILCOR International Consensus on CPR Science. Circulation. 2024;149(20):e660-e836.","guid":"8tR9KBacTr-ofGcNlpc-JA","children":[]},{"id":"341","parent":"332","text":"9. Cichero JA, et al. IDDSI framework. Dysphagia. 2017;32(2):293-314.","guid":"-t_m9G54QTqAucyIDkbgsg","children":[]}]}]}]},"node_count":341,"relations":[],"cross_references":[],"specialty":"Cardiología","folder":"Entidades clínicas/Cardiología","filename":"Taquiarritmias-2023","id":"map_95","resolved_references":[]}